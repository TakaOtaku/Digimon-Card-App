    "ng": "ng",
    "serve": "ng serve",
    "start": "serve -s dist/digimon-card-game-collector/browser",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
